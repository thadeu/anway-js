{
  "name": "@anway/client",
  "version": "0.5.3",
  "description": "Client and worker for the Anway job server, for Node and Bun",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thadeu/anway-js.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/thadeu/anway-js/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/thadeu/anway-js/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:bun": "bun test --timeout 20000 tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  }
}
